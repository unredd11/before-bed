# Copy this file to .env. Django loads it locally; .env is ignored by Git.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_TIME_ZONE=Asia/Singapore
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/callback/
RESEND_API_KEY=
RESEND_FROM=BeforeBed <onboarding@resend.dev>
